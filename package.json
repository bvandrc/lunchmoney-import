{
  "name": "lunchmoney-import",
  "version": "1.0.0",
  "private": true,
  "description": "Import Amazon order history and match it to Amazon transactions in Lunch Money by price and date",
  "keywords": [
    "amazon",
    "lunchmoney",
    "react",
    "vite"
  ],
  "homepage": "TODO-URL-UNKNOWN",
  "bugs": {
    "url": "https://github.com/bvandrc/lunchmoney-import/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/lunchmoney-import.git"
  },
  "author": "Blake Vandercar",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "start": "pnpm dev",
    "dev": "vite --open",
    "build": "vite build",
    "preview": "pnpm build && vite preview --open",
    "preview:ci": "vite preview --strictPort",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "pnpm format && pnpm ts:check",
    "format": "npx biome check . --fix",
    "ts:check": "tsc"
  },
  "dependencies": {
    "@lunch-money/lunch-money-js-v2": "^2",
    "@tanstack/react-query": "^5",
    "@tanstack/react-table": "^9",
    "clsx": "^2",
    "es-toolkit": "^1",
    "react": "^18",
    "react-dom": "^18",
    "react-ga4": "^3",
    "tailwind-merge": "^3",
    "usehooks-ts": "^3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "type-fest": "^5",
    "typescript": "^7",
    "vite": "^8"
  }
}
